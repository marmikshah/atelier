        point 1 18
      }
    }
  }
  frame 6 9 {
    pixels x=3 y=12 {
      legend {
        color "1" "#966032"
      }
      grid """
        .........1......1
        ........1........1


        ...........111
        ...........111
        ...........111
        ...........111
        1..........111
        .1
        """
