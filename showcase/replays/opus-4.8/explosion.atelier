      legend {
        color "1" "#9aa0a8"
        color "2" "#4a4e57"
      }
      grid """
        ...12
        ..111
        .11111
        2.111.2
        .1.1.1
        """
    }
  }
  frame 7 {
    pixels x=14 y=4 {
      legend {
        color "1" "#9aa0a8"
        color "2" "#4a4e57"
      }
      grid """
        ..1
        .1112
        .1111
        21.1
        ..1
        """
    }
  }
  frame 8 {
    pixels x=15 y=3 {
      legend {
        color "1" "#9aa0a8"
      }
      grid """
        .1
        .11
        111
        .1
        """
    }
  }
  frame 9 {
    pencil color="#9aa0a8" {
      points {
        point 16 3
        point 17 3
        point 16 4
      }
    }
  }
}

layer "debris" {
  frame 2 {
    pixels x=11 y=13 {
      legend {
        color "1" "#ff8a2b"
      }
      grid """
        .11.....11

        11.......11


        ..1.....1
        ..1.....1
        """
    }
  }
  frame 3 {
    pixels x=7 y=10 {
      legend {
        color "1" "#ff8a2b"
      }
      grid """
        ..11...........11



        11...............11





        ...1...........1
        ...1...........1
        """
    }
  }
  frame 4 {
    pencil color="#d63a26" {
      points {
        point 25 9
        point 7 9
        point 28 15
        point 29 15
        point 4 15
        point 3 15
        point 24 23
        point 8 23
      }
    }
  }
  frame 5 {
    pencil color="#d63a26" {
