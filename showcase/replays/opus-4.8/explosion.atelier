atelier "sc-opus-explosion" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#ffffff" "#ffe04a" "#ff8a2b" "#d63a26" "#9aa0a8" "#4a4e57"

layer "smoke" {
  frame 3 {
    pencil color="#4a4e57" {
      points {
        point 16 15
        point 16 14
        point 15 15
      }
    }
  }
  frame 4 {
    pixels x=14 y=12 {
      legend {
        color "1" "#4a4e57"
        color "2" "#9aa0a8"
      }
      grid """
        ..1
        .222
        22222
        12221
        ..1
        """
    }
  }
  frame 5 {
    pixels x=13 y=9 {
      legend {
        color "1" "#4a4e57"
        color "2" "#9aa0a8"
      }
      grid """
        ...1
        ..2221
        122222
        .222221
        ..222
        ..1
        """
    }
  }
  frame 6 {
