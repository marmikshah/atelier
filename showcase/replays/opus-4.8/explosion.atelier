        point 31 17
        point 1 17
        point 26 26
        point 6 26
      }
    }
  }
  frame 6 {
    pencil color="#d63a26" {
      points {
        point 27 28
      }
    }
  }
}

layer "core" {
  frame 0 {
    pixels x=15 y=15 {
      legend {
        color "1" "#ffe04a"
        color "2" "#ffffff"
      }
      grid """
        .1
        121
        .1
        """
    }
  }
  frame 1 {
    ellipse color="#ff8a2b" cx=16 cy=16 fill=#true rx=5 ry=5
    ellipse color="#ffe04a" cx=16 cy=16 fill=#true rx=4 ry=4
    ellipse color="#ffffff" cx=16 cy=16 fill=#true rx=2 ry=2
  }
  frame 2 {
    ellipse color="#ff8a2b" cx=16 cy=16 fill=#true rx=4 ry=4
    ellipse color="#ffe04a" cx=16 cy=16 fill=#true rx=2 ry=2
    pencil color="#ffffff" {
      points {
        point 16 16
      }
    }
  }
  frame 3 {
    ellipse color="#d63a26" cx=16 cy=16 fill=#true rx=3 ry=3
    ellipse color="#ff8a2b" cx=16 cy=16 fill=#true rx=2 ry=2
  }
  frame 4 {
    ellipse color="#d63a26" cx=16 cy=16 fill=#true rx=1 ry=1
  }
}

