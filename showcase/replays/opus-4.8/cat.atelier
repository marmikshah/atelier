    stroke aa=#false color="#6d5a99" width=2 {
      points {
        point 22 28
        point 25 27
        point 27 24
        point 28 21
        point 27 18
      }
    }
    pencil color="#a992d6" {
      points {
        point 27 17
      }
    }
  }
