layer "Exhaust FX" {
  frame 0 5 {
    pencil color="#889ba1" {
      points {
        point 2 21
      }
    }
  }
  frame 1 6 {
    pencil color="#889ba1" {
      points {
        point 1 21
        point 2 20
        point 2 21
      }
    }
  }
  frame 2 7 {
    pixels x=0 y=19 {
      legend {
        color "1" "#889ba1"
        color "2" "#f5dca7"
      }
      grid """
        .1
        12
        ..1
        """
    }
  }
  frame 3 8 {
