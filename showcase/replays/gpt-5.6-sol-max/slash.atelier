  }
  frame 6 {
    line color="#ffcf4c" size=1 x0=28 x1=31 y0=24 y1=20
    line color="#ffcf4c" size=1 x0=28 x1=31 y0=24 y1=29
    line color="#ffcf4c" size=1 x0=27 x1=22 y0=24 y1=29
