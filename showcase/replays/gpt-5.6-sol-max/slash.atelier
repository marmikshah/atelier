layer "impact sparks" {
  frame 4 {
    line color="#ffcf4c" size=1 x0=27 x1=29 y0=15 y1=17
    pencil color="#fffae2" size=1 {
      points {
        point 28 17
      }
    }
  }
  frame 5 {
    pixels x=23 y=18 {
      legend {
        color "1" "#ffcf4c"
        color "2" "#fffae2"
      }
      grid """
        ........1
        1......1
        .11...1
        ...1222
        ...22222
        ...222222
        ...22222
        ...12221
        ...1.2.1
        ..1..2..1
        .1
        """
