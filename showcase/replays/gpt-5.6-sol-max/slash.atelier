atelier "gpt56-slash" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#272f5b" "#3065b0" "#36c4da" "#a4ebfa" "#ffcf4c" "#fffae2"
tag "slash" direction="forward" from=0 to=9

layer "arc trail" {
  frame 1 {
    pixels x=2 y=3 {
      legend {
        color "1" "#3065b0"
        color "2" "#36c4da"
      }
      grid """
        ....11111
        ..11122221
        .1122222221
        1122221121
        .1121...1
        ..1
        """
    }
  }
  frame 2 {
    pixels x=1 y=2 {
      legend {
        color "1" "#272f5b"
        color "2" "#3065b0"
        color "3" "#36c4da"
      }
      grid """
        .....11111
        ...1111111111
        .11123333322111
        .1123333333332211
        11222322223333321
        .11222222222333321
        .111211..11122321
        ...1........11211
        ..............1
        """
    }
  }
  frame 3 {
    curve aa=#false color="#272f5b" snap=#true width=7 {
      points {
        point 4 6
        point 12 2
        point 21 11
      }
    }
    curve aa=#false color="#3065b0" snap=#true width=5 {
      points {
        point 5 6
        point 12 3
        point 21 11
      }
    }
    curve aa=#false color="#36c4da" snap=#true width=3 {
      points {
        point 7 5
        point 14 4
        point 21 11
      }
    }
  }
  frame 4 {
    curve aa=#false color="#272f5b" snap=#true width=9 {
      points {
        point 5 6
        point 16 2
        point 27 16
      }
    }
    curve aa=#false color="#3065b0" snap=#true width=7 {
      points {
        point 6 6
        point 16 3
        point 27 16
      }
    }
    curve aa=#false color="#36c4da" snap=#true width=4 {
      points {
        point 8 5
        point 18 5
        point 27 16
      }
    }
  }
  frame 5 {
    curve aa=#false color="#272f5b" snap=#true width=10 {
      points {
        point 6 7
        point 18 3
        point 29 22
      }
    }
    curve aa=#false color="#3065b0" snap=#true width=8 {
      points {
        point 7 7
        point 18 4
        point 29 22
      }
    }
    curve aa=#false color="#36c4da" snap=#true width=5 {
      points {
        point 9 6
        point 20 6
        point 29 22
      }
    }
  }
  frame 6 {
    curve aa=#false color="#272f5b" snap=#true width=7 {
      points {
        point 9 9
        point 21 7
        point 28 24
      }
    }
    curve aa=#false color="#3065b0" snap=#true width=5 {
      points {
        point 11 9
        point 22 9
        point 28 24
      }
    }
    curve aa=#false color="#36c4da" snap=#true width=3 {
      points {
        point 15 10
        point 24 12
        point 28 24
      }
    }
  }
  frame 7 {
    curve aa=#false color="#272f5b" snap=#true width=4 {
      points {
        point 14 13
        point 24 13
        point 29 24
      }
    }
    curve aa=#false color="#3065b0" snap=#true width=2 {
      points {
        point 18 14
        point 26 16
        point 29 24
      }
    }
  }
}

layer "hot edge" {
