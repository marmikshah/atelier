atelier "sc-fable-beam" format=1 renderer=1
canvas 48 48
frames 100 100 100 100 100 100 100 100 100 100
palette "#1a1c2c" "#4a5578" "#96a5c8" "#286ed2" "#5ad7ff" "#ffffff"

layer "body" {
