atelier "sc-fable-slash" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#ffffff" "#c8f0ff" "#ffe080" "#ff9830" "#d84820" "#7a2430"
tag "slash" direction="forward" from=0 to=9

