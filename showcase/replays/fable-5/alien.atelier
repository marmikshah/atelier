layer "eyes" {
  frame 0 8 9 {
    ellipse color="#101418" cx=11 cy=14 fill=#true rx=2 ry=2
    ellipse color="#101418" cx=20 cy=14 fill=#true rx=2 ry=2
    pencil color="#8fd97a" {
      points {
        point 10 13
        point 21 13
      }
    }
  }
  frame 1 2 {
    ellipse color="#101418" cx=11 cy=14 fill=#true rx=2 ry=2
