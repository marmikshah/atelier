layer "pulse" {
  frame 0 1 4 6 8 {
    rect color="#8f5f35" fill=#true x0=14 x1=17 y0=20 y1=20
  }
  frame 2 3 7 {
    rect color="#8f5f35" fill=#true x0=14 x1=17 y0=20 y1=21
