    line color="#bebec8" x0=0 x1=3 y0=10 y1=10
    line color="#bebec8" x0=19 x1=24 y0=30 y1=30
  }
  frame 3 8 {
    line color="#bebec8" x0=5 x1=10 y0=5 y1=5
    line color="#bebec8" x0=26 x1=31 y0=10 y1=10
    line color="#bebec8" x0=12 x1=17 y0=30 y1=30
  }
  frame 4 9 {
    line color="#bebec8" x0=0 x1=3 y0=5 y1=5
    line color="#bebec8" x0=19 x1=24 y0=10 y1=10
    line color="#bebec8" x0=5 x1=10 y0=30 y1=30
  }
}
