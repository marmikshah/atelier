layer "exhaust" {
  frame 0 5 {
    pencil color="#9898a4" {
      points {
        point 3 22
      }
    }
  }
  frame 1 6 {
    pencil color="#9898a4" {
      points {
        point 1 21
        point 2 22
      }
    }
  }
  frame 2 7 {
    pencil color="#9898a4" {
      points {
        point 0 20
        point 1 21
      }
    }
  }
}

