layer "bubbles" {
  frame 0 {
    ellipse color="#a8e696" cx=13 cy=28 fill=#true rx=1 ry=1
    pencil color="#a8e696" {
      points {
        point 18 15
        point 20 15
        point 19 14
        point 19 16
      }
    }
  }
  frame 1 {
    ellipse color="#a8e696" cx=13 cy=26 fill=#true rx=1 ry=1
  }
  frame 2 {
    ellipse color="#a8e696" cx=13 cy=24 fill=#true rx=1 ry=1
  }
  frame 3 {
    ellipse color="#a8e696" cx=13 cy=22 fill=#true rx=1 ry=1
  }
  frame 4 {
    ellipse color="#a8e696" cx=13 cy=20 fill=#true rx=1 ry=1
