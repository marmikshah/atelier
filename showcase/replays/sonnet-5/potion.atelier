layer "glass" {
  frame 0 {
    ellipse color="#241c1a" cx=16 cy=20 fill=#false rx=11 ry=10
    line color="#241c1a" x0=13 x1=13 y0=2 y1=13
    line color="#241c1a" x0=18 x1=18 y0=2 y1=13
    line color="#241c1a" x0=13 x1=18 y0=2 y1=2
    pencil color="#cdebee" {
      points {
        point 9 14
        point 10 13
        point 9 16
      }
    }
    pencil color="#cdebee" {
      points {
        point 14 4
        point 14 6
      }
    }
    pixel_perfect
  }
  frame 1 2 3 4 5 6 7 8 9 {
    ellipse color="#241c1a" cx=16 cy=20 fill=#false rx=11 ry=10
