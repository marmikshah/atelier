atelier "sc-sonnet-slash" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#ffffff" "#fff096" "#b4e1ff" "#5a96e6" "#284696"

layer "trail" {
  frame 1 {
    polyline color="#284696" size=1 {
      points {
        point 6 10
        point 9 8
      }
    }
  }
  frame 2 {
    pixels x=6 y=7 {
      legend {
        color "1" "#5a96e6"
        color "2" "#284696"
      }
      grid """
        .....1111
        ...11....111
        .22
        2
        """
    }
  }
  frame 3 {
    polyline color="#284696" size=1 {
      points {
        point 6 10
        point 9 8
        point 13 7
      }
    }
