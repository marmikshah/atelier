    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=0 dy=1 wrap=#false
  }
  frame 5 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=-1 dy=0 wrap=#false
  }
  frame 6 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=-2 dy=-1 wrap=#false
  }
  frame 7 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=-1 dy=-1 wrap=#false
  }
  frame 8 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=0 dy=-1 wrap=#false
  }
  frame 9 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=1 dy=-1 wrap=#false
  }
}

layer "eyes" {
  frame 0 {
    ellipse color="#141419" cx=12 cy=12 fill=#true rx=2 ry=3
    ellipse color="#141419" cx=20 cy=12 fill=#true rx=2 ry=3
  }
  frame 1 2 3 4 {
    ellipse color="#141419" cx=12 cy=12 fill=#true rx=2 ry=3
    ellipse color="#141419" cx=20 cy=12 fill=#true rx=2 ry=3
    shift dx=0 dy=1 wrap=#false
  }
  frame 5 {
    line color="#234628" size=1 x0=10 x1=14 y0=12 y1=12
    line color="#234628" size=1 x0=18 x1=22 y0=12 y1=12
  }
  frame 6 7 8 9 {
    ellipse color="#141419" cx=12 cy=12 fill=#true rx=2 ry=3
    ellipse color="#141419" cx=20 cy=12 fill=#true rx=2 ry=3
    shift dx=0 dy=-1 wrap=#false
  }
