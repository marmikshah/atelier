atelier "sc-sonnet-alien" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#234628" "#5fb469" "#a5e196" "#141419"
tag "idle" direction="forward" from=0 to=9

layer "body" {
  frame 0 5 {
    pixels x=7 y=19 {
      legend {
        color "1" "#234628"
        color "2" "#5fb469"
      }
      grid """
        .......11111
        ...111122222111
        ..11112222222111
        .1111222222222111
        111.12222222221111
        11..12222222221.11
        .....122222221
        .....112222211
        ......1111111
        """
    }
  }
  frame 1 2 3 4 {
    pixels x=7 y=20 {
      legend {
        color "1" "#234628"
        color "2" "#5fb469"
      }
      grid """
        .......11111
        ...111122222111
        ..11112222222111
        .1111222222222111
        111.12222222221111
        11..12222222221.11
        .....122222221
        .....112222211
        ......1111111
        """
    }
  }
  frame 6 7 8 9 {
    pixels x=7 y=18 {
      legend {
        color "1" "#234628"
        color "2" "#5fb469"
      }
      grid """
        .......11111
        ...111122222111
        ..11112222222111
        .1111222222222111
        111.12222222221111
        11..12222222221.11
        .....122222221
        .....112222211
        ......1111111
        """
    }
  }
}

layer "head" {
  frame 0 5 {
    ellipse color="#234628" cx=16 cy=13 fill=#true rx=9 ry=7
    ellipse color="#5fb469" cx=16 cy=13 fill=#true rx=8 ry=6
    ellipse color="#a5e196" cx=12 cy=8 fill=#true rx=3 ry=2
  }
  frame 1 2 3 4 {
    ellipse color="#234628" cx=16 cy=13 fill=#true rx=9 ry=7
    ellipse color="#5fb469" cx=16 cy=13 fill=#true rx=8 ry=6
    ellipse color="#a5e196" cx=12 cy=8 fill=#true rx=3 ry=2
    shift dx=0 dy=1 wrap=#false
  }
  frame 6 7 8 9 {
    ellipse color="#234628" cx=16 cy=13 fill=#true rx=9 ry=7
    ellipse color="#5fb469" cx=16 cy=13 fill=#true rx=8 ry=6
    ellipse color="#a5e196" cx=12 cy=8 fill=#true rx=3 ry=2
    shift dx=0 dy=-1 wrap=#false
  }
}

layer "antennae" {
  frame 0 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
  }
  frame 1 3 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
    ellipse color="#a5e196" cx=10 cy=2 fill=#true rx=1 ry=1
    ellipse color="#a5e196" cx=22 cy=2 fill=#true rx=1 ry=1
    shift dx=1 dy=1 wrap=#false
  }
  frame 2 {
    pixels x=11 y=2 {
      legend {
        color "1" "#a5e196"
        color "2" "#234628"
      }
      grid """
        111.........111
        111.........111
        111.........111
        ..2.........2
        ..2.........2
        ...2.......2
        ....2.....2
        """
    }
  }
  frame 4 {
    line color="#234628" size=1 x0=13 x1=10 y0=7 y1=3
    line color="#234628" size=1 x0=19 x1=22 y0=7 y1=3
