atelier "sc-sonnet-person" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#241814" "#e8b48c" "#6b4226" "#3f7d5c" "#3a4a6e" "#b4823c"
tag "jump" direction="forward" from=0 to=9

layer "legs" {
  frame 0 {
    rect color="#3a4a6e" fill=#true x0=13 x1=15 y0=20 y1=25
    rect color="#3a4a6e" fill=#true x0=17 x1=19 y0=20 y1=25
    rect color="#b4823c" fill=#true x0=12 x1=15 y0=26 y1=27
    rect color="#b4823c" fill=#true x0=17 x1=20 y0=26 y1=27
  }
  frame 1 9 {
    rect color="#3a4a6e" fill=#true x0=11 x1=14 y0=21 y1=25
    rect color="#3a4a6e" fill=#true x0=18 x1=21 y0=21 y1=25
    rect color="#b4823c" fill=#true x0=10 x1=14 y0=26 y1=27
    rect color="#b4823c" fill=#true x0=18 x1=22 y0=26 y1=27
  }
  frame 2 8 {
    rect color="#3a4a6e" fill=#true x0=9 x1=13 y0=22 y1=25
    rect color="#3a4a6e" fill=#true x0=19 x1=23 y0=22 y1=25
    rect color="#b4823c" fill=#true x0=8 x1=13 y0=26 y1=27
    rect color="#b4823c" fill=#true x0=19 x1=24 y0=26 y1=27
  }
  frame 3 {
    rect color="#3a4a6e" fill=#true x0=13 x1=15 y0=14 y1=24
    rect color="#3a4a6e" fill=#true x0=17 x1=19 y0=14 y1=24
    rect color="#b4823c" fill=#true x0=13 x1=16 y0=25 y1=26
    rect color="#b4823c" fill=#true x0=16 x1=19 y0=25 y1=26
  }
  frame 4 {
    rect color="#3a4a6e" fill=#true x0=11 x1=14 y0=13 y1=17
    rect color="#3a4a6e" fill=#true x0=18 x1=21 y0=13 y1=17
    rect color="#b4823c" fill=#true x0=12 x1=15 y0=18 y1=19
    rect color="#b4823c" fill=#true x0=17 x1=20 y0=18 y1=19
  }
  frame 5 {
    rect color="#3a4a6e" fill=#true x0=10 x1=13 y0=14 y1=17
    rect color="#3a4a6e" fill=#true x0=18 x1=21 y0=14 y1=17
    rect color="#b4823c" fill=#true x0=12 x1=15 y0=18 y1=19
    rect color="#b4823c" fill=#true x0=16 x1=19 y0=18 y1=19
  }
  frame 6 {
    pixels x=12 y=13 {
      legend {
        color "1" "#3a4a6e"
        color "2" "#b4823c"
      }
      grid """
        1111.1111
        1111.1111
        1111.1111
        1111.1111
        .111.111
        .111.111
        .111.111
        .111.111
        .2222222
        .2222222
        """
    }
  }
  frame 7 {
    rect color="#3a4a6e" fill=#true x0=13 x1=15 y0=16 y1=23
    rect color="#3a4a6e" fill=#true x0=17 x1=19 y0=16 y1=23
    rect color="#b4823c" fill=#true x0=12 x1=16 y0=24 y1=25
    rect color="#b4823c" fill=#true x0=16 x1=20 y0=24 y1=25
  }
}

layer "torso_head" {
  frame 0 {
    rect color="#6b4226" fill=#true x0=12 x1=19 y0=5 y1=7
    rect color="#e8b48c" fill=#true x0=12 x1=19 y0=8 y1=11
    pencil color="#241814" {
      points {
        point 14 9
        point 17 9
      }
    }
    rect color="#3f7d5c" fill=#true x0=11 x1=20 y0=12 y1=19
    line color="#b4823c" x0=11 x1=20 y0=18 y1=18
  }
  frame 1 9 {
    rect color="#6b4226" fill=#true x0=12 x1=19 y0=8 y1=10
    rect color="#e8b48c" fill=#true x0=12 x1=19 y0=11 y1=13
    pencil color="#241814" {
      points {
        point 14 12
        point 17 12
      }
    }
    rect color="#3f7d5c" fill=#true x0=10 x1=21 y0=14 y1=19
