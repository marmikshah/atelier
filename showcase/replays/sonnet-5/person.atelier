    rect color="#e8b48c" fill=#true x0=12 x1=19 y0=5 y1=7
    pencil color="#241814" {
      points {
        point 14 6
        point 17 6
      }
    }
    rect color="#3f7d5c" fill=#true x0=12 x1=19 y0=8 y1=13
    line color="#b4823c" x0=12 x1=19 y0=12 y1=12
  }
  frame 4 6 {
    rect color="#6b4226" fill=#true x0=12 x1=19 y0=1 y1=3
    rect color="#e8b48c" fill=#true x0=12 x1=19 y0=4 y1=6
    pencil color="#241814" {
      points {
        point 14 5
        point 17 5
      }
    }
    rect color="#3f7d5c" fill=#true x0=12 x1=19 y0=7 y1=12
    line color="#b4823c" x0=12 x1=19 y0=11 y1=11
  }
  frame 7 {
    rect color="#6b4226" fill=#true x0=12 x1=19 y0=4 y1=6
    rect color="#e8b48c" fill=#true x0=12 x1=19 y0=7 y1=9
    pencil color="#241814" {
      points {
        point 14 8
        point 17 8
      }
    }
    rect color="#3f7d5c" fill=#true x0=12 x1=19 y0=10 y1=15
    line color="#b4823c" x0=12 x1=19 y0=14 y1=14
  }
}

