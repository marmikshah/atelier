atelier "sc-fable51-ball" format=1 renderer=1
canvas 32 32
frames 100 100 100 100 100 100 100 100 100 100
palette "#de3a3e" "#8a1834" "#ffd6c4" "#2e243a"

layer "shadow" {
  frame 0 {
    pixels x=14 y=28 {
      legend {
        color "1" "#2e243a"
      }
      grid """
        11111
        ..1
        """
    }
  }
  frame 1 9 {
    pixels x=13 y=28 {
      legend {
        color "1" "#2e243a"
      }
      grid """
        1111111
        ..111
        """
    }
  }
  frame 2 8 {
