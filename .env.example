# atelier configuration — copy to .env and adjust. The default build holds no
# secrets and makes no network calls; these are local runtime knobs only. The
# one exception is the `agent` feature (bottom of this file).

# Where documents and exports live (default: ~/.atelier).
# ATELIER_HOME=~/.atelier

# HTTP bind address for `atelier --http` (default 127.0.0.1:8765).
# ATELIER_HTTP=127.0.0.1:8765

# Extra allowed Host headers for LAN/remote HTTP use (DNS-rebind guard).
# ATELIER_ALLOWED_HOSTS=workstation.local:8765,192.168.1.20:8765


# Record this session's tool calls into a replayable recipe at this path.
# ATELIER_RECORD=session.json

# Log verbosity (RUST_LOG syntax; default info). Logs go to stderr —
# the daemon collects them in ~/.atelier/logs/atelier.err.log.
# ATELIER_LOG=info

# --- `agent` feature only (cargo build --features agent) ----------------------
# The one online mode: `atelier agent` drives an OpenAI-compatible endpoint to
# draw by itself. Off by default; a normal build links no network stack.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
