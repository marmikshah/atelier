# atelier configuration — copy to .env and adjust. atelier holds no secrets and
# makes no network calls; these are local runtime knobs only.

# Where documents and exports live (default: ~/.atelier).
# ATELIER_HOME=~/.atelier

# HTTP bind address for `atelier --http` (default 127.0.0.1:8765).
# ATELIER_HTTP=127.0.0.1:8765

# Extra allowed Host headers for LAN/remote HTTP use (DNS-rebind guard).
# ATELIER_ALLOWED_HOSTS=workstation.local:8765,192.168.1.20:8765


# Record this session's tool calls into a replayable recipe at this path.
# ATELIER_RECORD=session.json
