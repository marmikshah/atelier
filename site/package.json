{
  "name": "atelier-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-showcase.mjs",
    "dev": "vite",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "check": "prettier --check src scripts index.html vite.config.ts tsconfig.json package.json .prettierrc.json && tsc --noEmit && node --test src/lib/comparison.test.ts",
    "prebuild": "node scripts/prepare-showcase.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
